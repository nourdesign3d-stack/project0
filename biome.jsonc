{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/core", "ultracite/react", "ultracite/next"],
  "javascript": {
    "globals": ["Liveblocks"]
  },
  "linter": {
    "rules": {
      "performance": {
        "noBarrelFile": "off"
      }
    }
  },
  "overrides": [
    {
      // `test.skip(condition, reason)` est l'API Playwright de saut conditionnel :
      // le test est déclaré et son absence est rapportée. Ce n'est pas un test
      // désactivé pour faire passer la CI (interdit par .claude/rules/quality.md,
      // et détecté par la règle Semgrep local-no-skipped-tests sur les tests unitaires).
      "includes": ["e2e/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noSkippedTests": "off"
          }
        }
      }
    }
  ],
  "files": {
    "includes": [
      "**/*",
      // Composants générés par shadcn et régénérés par `pnpm bump-ui`.
      // Mesuré le 2026-08-05 : 669 écarts de style, tous écrasés à la prochaine
      // régénération. Exclus du lint (style), mais PAS de Semgrep (sécurité) —
      // voir .semgrepignore.
      "!packages/design-system/components/ui",
      "!packages/design-system/lib",
      "!packages/design-system/hooks",
      "!packages/collaboration/config.ts",
      "!docs",
      "!apps/docs/**/*.json",
      "!apps/email/.react-email",
      "!packages/cms/basehub-types.d.ts"
    ]
  }
}
