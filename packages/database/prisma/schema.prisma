// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider     = "postgresql"
  relationMode = "prisma"
}

// This is a stub model.
// Delete it and add your own Prisma models.
model Page {
  id   Int    @id @default(autoincrement())
  name String
}

/// Événements de webhook déjà traités — garantit l'idempotence (R-012).
///
/// Ce modèle n'est **pas** du domaine : il est d'infrastructure, et ne suppose
/// rien du produit. C'est pourquoi il peut exister avant le modèle métier.
///
/// La clé primaire composite **est** le contrôle : une seconde insertion du même
/// événement échoue en base. Un `findFirst` suivi d'un `create` serait une
/// course, pas une garantie — voir .claude/rules/database.md.
model WebhookEvent {
  /// Fournisseur émetteur : "clerk", "stripe"…
  provider    String
  /// Identifiant de **livraison** du fournisseur, stable d'un réessai à l'autre.
  eventId     String
  /// Instant de la **réservation**, remis à jour lors d'une reprise (voir D-049).
  receivedAt  DateTime  @default(now())
  /// Instant où le traitement s'est **terminé avec succès**. `null` = réservé,
  /// pas encore abouti.
  ///
  /// Sans cette colonne, une ligne signifiait seulement « vu ». Un processus
  /// interrompu entre la réservation et la fin — redéploiement, délai dépassé,
  /// arrêt du conteneur — laissait donc une réservation que rien ne libérait :
  /// le réessai du fournisseur était pris pour un doublon et l'événement perdu
  /// en silence. Voir D-049.
  completedAt DateTime?

  @@id([provider, eventId])
  /// Sert la purge par ancienneté **et** la reprise des réservations abandonnées.
  /// Sans lui, les deux balaient la table entière à chaque passage.
  @@index([receivedAt])
}
