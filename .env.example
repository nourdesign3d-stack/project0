# Variables lues par Docker Compose uniquement (pas par les applications).
# Copier en `.env` à la racine (non versionné) et adapter si nécessaire.
#
# Nom de la base locale et port exposé sur l'hôte.
# Choisir un port libre : `lsof -nP -iTCP:5432 -sTCP:LISTEN` pour vérifier.
POSTGRES_DB=app
POSTGRES_PORT=5432
